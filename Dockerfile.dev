# ===============================
# 🧱 Dockerfile.dev - Development mode for Vue (Vite)
# ===============================

# 1️⃣ Base image Node.js (phiên bản 22.x mới nhất)
FROM node:22.21.0

# 2️⃣ Set working directory trong container
WORKDIR /app

# 3️⃣ Copy file package.json & package-lock.json (để cài đúng dependencies)
COPY package*.json ./

# 4️⃣ Cài dependencies
RUN npm install

# 5️⃣ Copy toàn bộ mã nguồn
COPY . .

# 6️⃣ Expose port của Vite (thường là 5173)
EXPOSE 5173

# 7️⃣ Lệnh chạy dev server (hot reload)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
